{
  "name": "Radar - resumen semanal",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 19 * * 0"
            }
          ]
        }
      },
      "id": "resumen-semanal-cron",
      "name": "Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://TU-URL-PUBLICA/jobs/resumen-semanal",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Radar-Token",
              "value": "CAMBIA_ESTE_TOKEN"
            }
          ]
        },
        "options": {
          "timeout": 180000
        }
      },
      "id": "resumen-semanal-http",
      "name": "POST /jobs/resumen-semanal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "notes": "Domingos 19:00 (Lima). Resumen de la semana (en texto; el audio llega con la Fase 5).",
      "notesInFlow": true
    }
  ],
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "POST /jobs/resumen-semanal",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Lima"
  },
  "active": false
}
