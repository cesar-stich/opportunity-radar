{
  "name": "Radar - escaneo diario",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "escanear-cron",
      "name": "Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://TU-URL-PUBLICA/jobs/escanear",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Radar-Token",
              "value": "CAMBIA_ESTE_TOKEN"
            }
          ]
        },
        "options": {
          "timeout": 180000
        }
      },
      "id": "escanear-http",
      "name": "POST /jobs/escanear",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "notes": "Todos los días 8:00 (Lima). El agente busca y solo avisa lo nuevo con puntaje >= NOTIFY_MIN_SCORE.",
      "notesInFlow": true
    }
  ],
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "POST /jobs/escanear",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Lima"
  },
  "active": false
}
