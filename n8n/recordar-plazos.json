{
  "name": "Radar - recordatorio de plazos",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "recordar-plazos-cron",
      "name": "Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://TU-URL-PUBLICA/jobs/recordar-plazos",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Radar-Token",
              "value": "CAMBIA_ESTE_TOKEN"
            }
          ]
        },
        "options": {
          "timeout": 180000
        }
      },
      "id": "recordar-plazos-http",
      "name": "POST /jobs/recordar-plazos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "notes": "Todos los días 9:00 (Lima). Avisa una vez lo que te interesa y cierra en 3 días o menos.",
      "notesInFlow": true
    }
  ],
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "POST /jobs/recordar-plazos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Lima"
  },
  "active": false
}
