PORT=3000
DB_PATH=data/radar.db

# Cerebro (LLM). Por defecto mock: corre sin llaves.
LLM_PROVIDER=mock        # mock | gemini | groq | anthropic (solo de pago, no activar)
LLM_MODEL=               # vacío = default del proveedor (gemini-3.8-flash / openai/gpt-oss-120b)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey (capa gratuita)
GROQ_API_KEY=            # https://console.groq.com/keys (capa gratuita)
ANTHROPIC_API_KEY=

# Canal de mensajería
CHANNEL=mock             # mock | zavu-whatsapp | zavu-telegram
TELEGRAM_BOT_TOKEN=
ZAVU_API_KEY=
ZAVU_WEBHOOK_SECRET=     # secreto del webhook del sender (Zavu → Sender → Webhook). Obligatorio con ZAVU_MODE=real
ZAVU_SENDER_ID=          # snd_… (opcional si solo tienes un sender)
ALLOWED_SENDERS=         # tu chat id de Telegram (o teléfono +51…); si está vacío, el bot te dice tu ID al escribirle

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ATOMICMEMORY_URL=https://api.atomicstrata.ai   # Cloud (perk). Local con Docker: http://localhost:17350
ATOMICMEMORY_API_KEY=     # Cloud: amc_... (memory.atomicstrata.ai → API Keys). Local: vacío
TAVILY_API_KEY=
APIFY_TOKEN=
JOBS_TOKEN=cambia-esto
API_TOKEN=                # protege /ask, /chat y /api/*; obligatorio en producción (NODE_ENV=production)
PANEL_TOKEN=              # solo lectura de /api/*: el que lleva el panel de Lovable en el navegador
MATCH_TOKEN=              # si se define, /match exige este Bearer (el que va en el ítem de Qatom)
PUBLIC_URL=               # URL pública del servidor (Maritime/túnel); necesaria para ENVIAR audios por Zavu
NOTIFY_MIN_SCORE=70

# Interruptores: mock | real
ZAVU_MODE=mock
VOICE_MODE=mock
MEMORY_MODE=mock
TAVILY_MODE=mock
APIFY_MODE=mock
REPLY_AS_VOICE=false
