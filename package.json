{
  "name": "radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente que caza oportunidades (prácticas, becas, hackathones, cursos) para estudiantes y avisa por Telegram",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/db/seed.ts",
    "escanear": "tsx src/escanear.ts",
    "fuentes": "tsx src/escanear.ts fuentes",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
